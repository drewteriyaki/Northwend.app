# Every setting Northwend reads, with what it's for. No real values here, ever.
#
# Running locally: copy this file to `.env` (git-ignored) and fill in what you
# need. Only the names marked (.env) are read from that file; the rest are
# read from the environment only (set them in your shell, or in the host's
# settings). On a hosted copy each one is a secret or variable on the host:
#   - Streamlit Community Cloud: the app's Settings > Secrets (one per app:
#     live and staging have their own).
#   - Render (once step 4 lands): the service's Environment. render.yaml
#     lists every setting the live app needs (a test checks against this file).
#   - GitHub Actions jobs: Settings > Secrets and variables > Actions.
# docs/RUNBOOK.md says where each one lives and what to restart after a change.
# A test (tests/test_ops_docs.py) fails when the code reads a name that
# isn't listed here - add new settings to this file.

# ---- Which copy this is ------------------------------------------------------

# "production", "staging" or empty (your own computer). Hosted copies fail
# closed: no Postgres PORTFOLIO_DB, no start (settings.py).
NORTHWEND_ENV=

# ---- Database ---------------------------------------------------------------

# The database: a Postgres connection string (postgresql://...) on hosted
# copies; empty locally means portfolio.db beside the code.
PORTFOLIO_DB=

# The same connection string under the name the GitHub jobs use (error_alerts.py
# falls back to it). Not needed locally.
DATABASE_URL=

# 1 means this copy doesn't create or change tables when it starts; only
# `northwend-migrate`, run as the database's owner role, does (docs/DB_ROLES.md).
# For a copy whose database role can't change the schema (northwend_app or
# northwend_jobs, made by `northwend-migrate --roles`). Empty or 0: the app
# sets its schema up itself at start, as it always has. Set by hand beside
# PORTFOLIO_DB (Render's Environment, staging's Secrets, a GitHub variable).
NORTHWEND_SKIP_SCHEMA_SETUP=

# ---- Keys (.env) --------------------------------------------------------------

# Anthropic API key for Ask Northwend and the other AI helpers (.env). Empty
# means no AI: those features say so calmly. https://console.anthropic.com
ANTHROPIC_API_KEY=

# The eval workspace's Anthropic key, for `python -m evals.run` only (set it in
# the shell for that run; never in an app's secrets, never production's key).
# The app never reads it. Empty means the eval refuses to run.
ANTHROPIC_API_KEY_EVAL=

# Resend API key for email (.env). Empty means no email is sent.
RESEND_API_KEY=

# Finnhub API key for live prices (.env): update_prices.py and the app's
# refresh. The free tier is enough. https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Polygon (also called Massive) API key for announced dividend dates
# (dividend_dates.py, the nightly job; the free plan is enough). Empty means no calls.
POLYGON_API_KEY=

# The same key under Massive's name - read only when POLYGON_API_KEY is empty.
MASSIVE_API_KEY=

# Another address for the dividend data API; empty means https://api.polygon.io.
DIVIDEND_API_BASE=

# The key two-step sign-in's stored authenticator keys are encrypted with
# (two_step.py; audit 1.1e) - environment only, never read from .env. Make one
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating: put the new key first, a comma, then the old one; run
# `manage_users.py encrypt-two-step --rotate`; then drop the old one. Each
# copy (live, staging) has its own. Empty: those keys are stored readable
# (fine locally; Admin > System says so on a hosted copy). Keep a copy of it
# somewhere safe outside the host: without it, nobody's app codes work.
NORTHWEND_TOTP_KEY=

# ---- Email (.env) --------------------------------------------------------------

# 1 logs emails instead of sending them (.env). Keep it on for local runs
# and staging; empty or 0 on the live copy.
MAIL_DRY_RUN=1

# Where mail for the admin goes - error and job alerts, advisor requests, AI spend and licence
# reminders (.env). Empty means admin@northwend.app.
ALERT_EMAIL=

# The app's address, for links in emails (the jobs, and the app's own reset,
# confirm and setup links - set it on every hosted copy, each to its own
# address), e.g. https://go.northwend.app/ - empty: the jobs use that default.
APP_URL=

# ---- Gates, flags and limits ------------------------------------------------

# Legal gates that are open, e.g. "L0" or "L0,L1a,L3". Only L0, L1a, L1b, L2
# and L3 exist (L1a = advisor workspace seats and billing; L1b = anything that
# connects a person to an advisor, only with L2); the old "L1" still means
# both L1a and L1b. Never turn one on without its checklist in docs/RUNBOOK.md.
NORTHWEND_GATES=

# Features turned on, e.g. "walk,screenshot_ai" (flags.FEATURES). Empty means
# all off. Staging turns everything on; live only what's approved
# (decoder_public, the decoder without an account, needs L0 too and goes live
# only after the move to Render behind Cloudflare - CLIENT_IP_HEADER below;
# advisor_agreement asks advisors to accept the agreement before Your clients;
# billing, paid advisor seats through Stripe, needs L1a and the Stripe settings
# below; directory, Find a guide and advisors' listings, needs L1b and L2;
# intros, introductions and the two-step consent to full sharing, needs L1b, L2
# and directory).
NORTHWEND_FLAGS=

# The app-wide AI spend a month, in US dollars (ai_spend.py). Empty means 100;
# 0 rests every AI feature at once.
NORTHWEND_AI_CEILING_USD=

# The most accounts people can make for themselves on Create account in one day
# (midnight to midnight US Eastern); after that the page says "We're full for
# today". Empty, 0 or not a whole number means no cap.
NORTHWEND_MAX_SIGNUPS_PER_DAY=

# 1 once zero data retention (ZDR) is confirmed with Anthropic for this copy's
# key (ai_gateway.py). Empty: a hosted copy refuses any AI helper that could
# carry a dollar figure. Leave empty until Anthropic confirms it in writing.
AI_ZDR=

# Logins that get the Admin portal, separated by commas or spaces. Admins are
# never made inside the app.
NORTHWEND_ADMINS=

# Optional: the target share (a percent, e.g. 40) of people who take a second
# monthly walk within 45 days - shown beside the figure in Admin > Feature tests.
NORTHWEND_SECOND_WALK_TARGET=

# ---- Paid advisor seats (billing.py; flag billing + gate L1a) ----------------
# Steps in docs/RUNBOOK.md, "Billing: Stripe setup". Test mode first.

# Stripe restricted key (rk_test_... on staging, rk_live_... on live only) with
# only Checkout Sessions, Customer portal and Subscriptions rights.
STRIPE_SECRET_KEY=
# Stripe price id (price_...) of the founding seat billed monthly ($79 a month).
STRIPE_PRICE_MONTHLY=
# Stripe price id (price_...) of the founding seat billed yearly ($790 a year).
STRIPE_PRICE_YEARLY=
# Optional: the standard monthly price id, used once the founding places are gone.
STRIPE_PRICE_STANDARD_MONTHLY=
# Optional: the standard yearly price id, used once the founding places are gone.
STRIPE_PRICE_STANDARD_YEARLY=
# How many founding places there are, ever (empty means 20).
NORTHWEND_FOUNDING_SEATS=
# The founding prices as shown on the page, "monthly/yearly" (empty means 79/790).
NORTHWEND_SEAT_PRICES=
# Optional: the standard prices as shown, e.g. 99/990 (empty: the founding ones).
NORTHWEND_STANDARD_SEAT_PRICES=
# Days an advisor can still add clients and send with no active seat (empty means 14).
NORTHWEND_SEAT_GRACE_DAYS=

# ---- Hosting -----------------------------------------------------------------

# The request header with the visitor's real address behind a proxy
# (hosting.py): x-forwarded-for on Render, cf-connecting-ip behind Cloudflare.
# Empty on Community Cloud and locally. The sign-up, email and no-account
# decoder limits count per address, so set it behind any proxy.
CLIENT_IP_HEADER=

# Set only on an old copy after a move, e.g. https://go.northwend.app - every
# page then says where Northwend is now.
MOVED_TO=

# ---- Read by Streamlit or Render themselves (render.yaml sets them) ----------
# Not needed locally: .streamlit/config.toml covers the first two there.

# The largest upload in MB: 10 (audit 1.3b).
# STREAMLIT_SERVER_MAX_UPLOAD_SIZE=
# false: no usage statistics sent from visitors' browsers to Streamlit.
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=
# none on a hosted copy: the browser shows a generic error message only - no
# exception type, message or traceback (audit 1.8a).
# STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=
# The Python version Render builds with (CI tests on the same minor version).
# PYTHON_VERSION=

# ---- Set by the host, never by you (listed so every name is documented) -----

# Render sets this on its servers; it tells settings.py the copy is hosted.
# RENDER=
# Render sets this to the commit it deployed; Admin > System shows it.
# RENDER_GIT_COMMIT=
# The machine's name; Streamlit Community Cloud's starts with "streamlit".
# HOSTNAME=

# ---- Tests only --------------------------------------------------------------

# A throwaway Postgres for tests/test_postgres.py (never Neon). Empty skips them.
# NORTHWEND_TEST_PG=postgresql://postgres@localhost:5432/northwend_test
# 1 makes a skipped Postgres test count as a failure (CI sets it).
# NORTHWEND_TEST_PG_REQUIRED=
# Lowers the password-hash iterations for fast local test runs (tests set it).
# Ignored on a hosted copy.
# NORTHWEND_PBKDF2_ITERATIONS=
